---
import "../styles/base.css";

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>Página no encontrada — Glassmorphism Lab</title>
    <meta name="robots" content="noindex, follow" />
    <meta
      name="theme-color"
      content="#f3f4f7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c0e12"
      media="(prefers-color-scheme: dark)"
    />
  </head>
  <body>
    <div class="wrap">
      <header>
        <p class="eyebrow">Error 404</p>
        <h1 class="main-title">Esta página se desvaneció</h1>
        <p class="lede">
          No encontramos lo que buscabas. Puede que el enlace esté roto o que el
          panel se haya movido de sitio.
        </p>
        <p style="margin-top: 24px">
          <a href={base}>Volver al laboratorio</a>
        </p>
      </header>
    </div>
  </body>
</html>
