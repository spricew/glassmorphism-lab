---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import geistLatin from "../fonts/geist-latin.woff2?url";
import geistMonoLatin from "../fonts/geist-mono-latin.woff2?url";

const base = import.meta.env.BASE_URL;

const title = "Página no encontrada — Glassmorphism Lab";
const description =
  "No encontramos esta página. Vuelve al laboratorio para desglosar el vidrio esmerilado de iOS capa por capa.";

const fontPreloads = [geistLatin, geistMonoLatin];
---

<Base
  title={title}
  description={description}
  robots="noindex, follow"
  wrapClass="wrap wrap-404"
  fontPreloads={fontPreloads}
>
      <main id="main" tabindex="-1">
        <section class="glass glasspane" aria-labelledby="h404">
          <span class="ghost" aria-hidden="true">404</span>
          <div class="glass-body">
            <p class="eyebrow">Error 404</p>
            <h1 class="main-title" id="h404">Esta página se desvaneció</h1>
            <p class="lede">
              No encontramos lo que buscabas. Puede que el enlace esté roto o
              que el panel se haya movido de sitio.
            </p>
            <div class="actions">
              <a class="btn" href={base} rel="noopener noreferrer">Volver al laboratorio</a>
            </div>
          </div>
        </section>
      </main>
</Base>

<style is:global>
  .wrap-404 {
    position: relative;
    min-height: 100dvh;
    justify-content: center;
    align-items: center;
    gap: 40px;
  }
  .wrap-404 main {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* layout del panel; la vista de vidrio (tinte, blur, canto, grano) viene de .glasspane */
  .glass {
    overflow: hidden;
    width: min(600px, 100%);
    border-radius: 28px;
    padding: clamp(26px, 4.5vw, 48px);
  }
  .glass .ghost {
    position: absolute;
    top: clamp(-14px, -1.5vw, -6px);
    right: clamp(8px, 3vw, 26px);
    font: 600 clamp(96px, 24vw, 190px) / 1 var(--font);
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line);
    opacity: 0.75;
    pointer-events: none;
    user-select: none;
  }
  .glass-body {
    position: relative;
    z-index: 1;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(20px, 3vw, 28px);
  }
  .actions .btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 560px) {
    .glass .ghost {
      opacity: 0.5;
    }
  }
</style>
