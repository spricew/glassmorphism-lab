---
import "../styles/global.css";
import geistLatin from "../fonts/geist-latin.woff2?url";
import geistMonoLatin from "../fonts/geist-mono-latin.woff2?url";

const base = import.meta.env.BASE_URL;
const canonical = Astro.url.href;
const title = "Página no encontrada — Glassmorphism Lab";
const description =
  "No encontramos esta página. Vuelve al laboratorio para desglosar el vidrio esmerilado de iOS capa por capa.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Glassmorphism Lab" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link
      rel="icon"
      href={`${base}favicon-32.png`}
      sizes="32x32"
      type="image/png"
    />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta
      name="theme-color"
      content="#f3f4f7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c0e12"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistLatin}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistMonoLatin}
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div class="ambient" aria-hidden="true"></div>
    <div class="wrap wrap-404">
      <main id="main" tabindex="-1">
        <section class="glass glasspane" aria-labelledby="h404">
          <span class="ghost" aria-hidden="true">404</span>
          <div class="glass-body">
            <p class="eyebrow">Error 404</p>
            <h1 class="main-title" id="h404">Esta página se desvaneció</h1>
            <p class="lede">
              No encontramos lo que buscabas. Puede que el enlace esté roto o
              que el panel se haya movido de sitio.
            </p>
            <div class="actions">
              <a class="btn" href={base} rel="noopener noreferrer">Volver al laboratorio</a>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<style>
  .wrap-404 {
    position: relative;
    min-height: 100dvh;
    justify-content: center;
    align-items: center;
    gap: 40px;
  }
  .wrap-404 main {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* layout del panel; la vista de vidrio (tinte, blur, canto, grano) viene de .glasspane */
  .glass {
    overflow: hidden;
    width: min(600px, 100%);
    border-radius: 28px;
    padding: clamp(26px, 4.5vw, 48px);
  }
  .glass .ghost {
    position: absolute;
    top: clamp(-14px, -1.5vw, -6px);
    right: clamp(8px, 3vw, 26px);
    font: 600 clamp(96px, 24vw, 190px) / 1 var(--font);
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line);
    opacity: 0.75;
    pointer-events: none;
    user-select: none;
  }
  .glass-body {
    position: relative;
    z-index: 1;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(20px, 3vw, 28px);
  }
  .actions .btn {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 560px) {
    .glass .ghost {
      opacity: 0.5;
    }
  }
</style>
