---
import "../styles/global.css";
import "../styles/frosted.css";
import { frosted } from "../lib/frosted/index.ts";
import { panelHTML, shell } from "../lab/panels.ts";
import geistLatin from "../fonts/geist-latin.woff2?url";
import geistMonoLatin from "../fonts/geist-mono-latin.woff2?url";

const base = import.meta.env.BASE_URL;
const canonical = Astro.url.href;
const abs = (file: string) =>
  new URL(base + file, Astro.site ?? Astro.url).href;

const title = "Glassmorphism Lab — desglose del backdrop-filter de iOS";
const description =
  "Laboratorio del vidrio esmerilado (frosted glass) de iOS: apila backdrop-filter, saturación, tinte, borde y brillo capa por capa y mira cómo cambia cada paso.";
const ogImage = abs("og-image.webp");
const imageAlt =
  "Panel de vidrio esmerilado de Glassmorphism Lab sobre un fondo de mosaico con formas y colores vivos.";

interface FaqItem {
  q: string;
  a: string;
}

const faq: FaqItem[] = [
  {
    q: "¿Qué es el glassmorphism?",
    a: "Es un estilo de interfaz que imita el vidrio esmerilado: paneles translúcidos que difuminan lo que hay detrás, con un tinte sutil, un borde fino y un brillo interior. Apple lo popularizó en iOS 7 y sigue presente en iOS 18, macOS y visionOS.",
  },
  {
    q: "¿Cómo se hace el efecto de vidrio esmerilado en CSS?",
    a: "Con la propiedad backdrop-filter. La receta mínima es backdrop-filter: blur(24px) saturate(180%) más un fondo translúcido con background-color en rgba para el tinte, y un borde de 0,5 px con un brillo interior para definir el canto del panel.",
  },
  {
    q: "¿Qué navegadores soportan backdrop-filter?",
    a: "Todos los navegadores modernos: Chrome, Edge, Safari (con el prefijo -webkit-) y Firefox. En navegadores antiguos el panel se muestra sin desenfoque, así que conviene garantizar el contraste del texto con el tinte por si el filtro no se aplica.",
  },
  {
    q: "¿Por qué mi backdrop-filter no se ve?",
    a: "Casi siempre por el contexto de apilamiento. Si un ancestro tiene transform, opacity menor que 1, filter o z-index, Chromium trata ese elemento como raíz del fondo y el blur deja de ver lo que hay detrás. Evita esos valores en la cadena de ancestros del panel.",
  },
];

interface TryItem {
  t: string;
  d: string;
}

const tries: TryItem[] = [
  {
    t: "Apaga la saturación en Paisaje",
    d: "Sin ella el blur deja el cielo en un gris apagado. Con 180 % el naranja del sol sobrevive al difuminado.",
  },
  {
    t: "Baja el tinte a cero en App",
    d: "El texto de atrás sigue casi legible a través del vidrio. El tinte no es decoración, es lo que garantiza el contraste.",
  },
  {
    t: "Activa Vibrancy en oscuro",
    d: "Las etiquetas dejan de ser un gris plano y toman el color del fondo. Se aprecia mejor sobre Mosaico.",
  },
  {
    t: "Quita borde y brillo",
    d: "Cada uno pesa poco, pero sin ellos el panel pierde canto y se lee como una mancha en lugar de un objeto.",
  },
];

type SegOption = [value: string, label: string];

const bgOptions: SegOption[] = [
  ["mosaic", "Mosaico"],
  ["sunset", "Paisaje"],
  ["feed", "App"],
];

const modeOptions: SegOption[] = [
  ["light", "Claro"],
  ["dark", "Oscuro"],
];

const viewOptions: SegOption[] = [
  ["full", "Receta completa"],
  ["naive", "Solo blur"],
];

const fontPreloads = [geistLatin, geistMonoLatin];

/* el mini panel es idéntico en los 8 pasos: se construye una sola vez */
const miniPanelHTML = shell(
  panelHTML(
    frosted.mini.title,
    frosted.mini.sub,
    frosted.mini.rows,
    frosted.mini.foot,
  ),
);

const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonical}#website`,
      url: canonical,
      name: "Glassmorphism Lab",
      inLanguage: "es",
      publisher: { "@id": `${canonical}#author` },
      about: { "@id": `${canonical}#app` },
    },
    {
      "@type": "Person",
      "@id": `${canonical}#author`,
      name: "spricew",
      url: "https://github.com/spricew",
      sameAs: ["https://github.com/spricew/glassmorphism-lab"],
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical}#app`,
      name: "Glassmorphism Lab",
      url: canonical,
      image: ogImage,
      screenshot: ogImage,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web",
      browserRequirements: "Requiere JavaScript",
      inLanguage: "es",
      author: { "@id": `${canonical}#author` },
      description:
        "Glassmorphism Lab es un laboratorio interactivo para desglosar el vidrio esmerilado (frosted glass) de iOS capa por capa: backdrop-filter, saturación, tinte, borde y brillo.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    },
    {
      "@type": "HowTo",
      "@id": `${canonical}#howto`,
      name: "Cómo recrear el vidrio esmerilado de iOS con CSS",
      inLanguage: "es",
      description:
        "Reconstruye el material translúcido de iOS apilando capas de CSS y ajustando cada una hasta obtener el efecto deseado.",
      step: [
        {
          "@type": "HowToStep",
          name: "Aplica el desenfoque",
          text: "Usa backdrop-filter: blur() para difuminar lo que hay detrás del panel.",
        },
        {
          "@type": "HowToStep",
          name: "Añade saturación",
          text: "Combinar blur() con saturate() evita que el color de fondo se vuelva gris apagado.",
        },
        {
          "@type": "HowToStep",
          name: "Aplica el tinte",
          text: "Añade un relleno translúcido con background-color en rgba para garantizar el contraste del texto.",
        },
        {
          "@type": "HowToStep",
          name: "Remata con borde y brillo",
          text: "Un borde sutil y un brillo interior definen el canto del panel para que se lea como un objeto.",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      inLanguage: "es",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="spricew" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Glassmorphism Lab" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link
      rel="icon"
      href={`${base}favicon-32.png`}
      sizes="32x32"
      type="image/png"
    />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta
      name="theme-color"
      content="#f3f4f7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c0e12"
      media="(prefers-color-scheme: dark)"
    />
    {
      fontPreloads.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div class="ambient" aria-hidden="true"></div>
    <div class="wrap">
      <header>
        <p class="eyebrow">Material translúcido clásico · iOS 7 a iOS 18</p>
        <h1 class="main-title">Glassmorphism Lab</h1>
        <p class="lede">
          El vidrio esmerilado de Apple es una pila de capas, no un blur.
          Arrastra el panel sobre el fondo, apaga las capas una por una y mira
          qué se pierde.
        </p>
      </header>

      <main id="main" tabindex="-1">
      <section class="lab" aria-label="Laboratorio">
        <div class="stagecol">
          <div class="stage" id="stage">
            <div class="bg" id="bg" aria-hidden="true"></div>
            <span class="chip state" id="chipState" aria-live="polite"
              >Receta completa</span
            >
            <button
              class="chip hold"
              id="hold"
              type="button"
              aria-pressed="false"
            >
              Mantén para ver solo blur
            </button>
            <div class="gl bar" id="bar" aria-hidden="true"></div>
            <p class="sr-only" id="panelHint">
              Puedes mover el panel con las teclas de flecha cuando está
              enfocado.
            </p>
            <div
              class="gl panel"
              id="panel"
              tabindex="0"
              role="group"
              aria-label="Panel de vidrio arrastrable"
              aria-describedby="panelHint"
            ></div>
          </div>
          <div class="stagefoot">
            <div class="seg" data-seg="bg" role="radiogroup" aria-label="Fondo">
              {
                bgOptions.map(([value, label]) => (
                  <button type="button" role="radio" aria-checked="false" data-v={value}>{label}</button>
                ))
              }
            </div>
            <label class="sw"
              ><input type="checkbox" role="switch" id="animate" /><span
                class="trk"
                aria-hidden="true"
              ></span
              ><span class="nm">Mover el fondo</span></label
            >
            <label class="sw"
              ><input type="checkbox" role="switch" id="showbar" checked /><span
                class="trk"
                aria-hidden="true"
              ></span
              ><span class="nm">Barra de pestañas</span></label
            >
          </div>
        </div>

        <aside class="inspector glasspane" aria-label="Capas del material">
          <div class="group">
            <span class="eyebrow">Apariencia</span>
            <div
              class="seg wide"
              data-seg="mode"
              role="radiogroup"
              aria-label="Apariencia"
            >
              {
                modeOptions.map(([value, label]) => (
                  <button type="button" role="radio" aria-checked="false" data-v={value} class="font-btn">{label}</button>
                ))
              }
            </div>
            <span class="eyebrow mt-4"
              >Grosor · <span id="matName" class="mat-name">regular</span></span
            >
            <div
              class="seg wide"
              data-seg="material"
              role="radiogroup"
              aria-label="Grosor"
            >
              {
                frosted.presets.map((preset) => (
                  <button type="button" role="radio" aria-checked="false" data-v={preset.id} aria-label={preset.id}>{preset.label}</button>
                ))
              }
            </div>
            <span class="eyebrow mt-4">Vista</span>
            <div
              class="seg wide"
              data-seg="view"
              role="radiogroup"
              aria-label="Vista"
            >
              {
                viewOptions.map(([value, label]) => (
                  <button type="button" role="radio" aria-checked="false" data-v={value} class="font-btn">{label}</button>
                ))
              }
            </div>
          </div>
          {
            frosted.inspectorGroups.map((group) => (
              <>
                <hr />
                <div class="group" id={group.id}><span class="eyebrow">{group.label}</span></div>
              </>
            ))
          }
        </aside>

        <div class="codebox glasspane">
          <div class="codehead">
            <span class="eyebrow">CSS resultante</span>
            <button class="btn" id="copy" type="button" aria-describedby="copyStatus">
              Copiar CSS
            </button>
            <span class="sr-only" id="copyStatus" role="status" aria-live="polite"></span>
          </div>
          <pre class="code" id="code" tabindex="0" aria-label="CSS resultante"></pre>
        </div>
      </section>

      <section class="build" aria-labelledby="hBuild">
        <div>
          <h2 id="hBuild">Construcción capa por capa</h2>
          <p class="lede">
            El mismo panel sumando una capa por celda. Usa la apariencia y el
            fondo que elegiste arriba, así puedes ver cómo cambia cada paso
            según lo que hay detrás.
          </p>
        </div>
        <div class="steps" id="steps">
          {
            frosted.steps.map((s, i) => (
              <article class="step">
                <div class="mini" data-i={i} aria-hidden="true">
                  <div class="gl" set:html={miniPanelHTML} />
                </div>
                <div>
                  <h3>
                    <span>{i}</span>
                    {s.t}
                  </h3>
                  <p>{s.d}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="build" aria-labelledby="hTry">
        <h2 id="hTry">Cosas para probar</h2>
        <div class="tries">
          {
            tries.map(({ t, d }) => (
              <div class="try">
                <strong>{t}</strong>
                <p>{d}</p>
              </div>
            ))
          }
        </div>
        <p class="foot">
          Los grosores son aproximaciones calibradas a ojo, no los valores
          internos del sistema. La referencia pública más cercana es el sample
          code <a href="https://developer.apple.com/library/archive/samplecode/UIImageEffects/Introduction/Intro.html" rel="noopener noreferrer">UIImageEffects</a>,
          que usa saturación 1,8 y un tinte de alfa entre 0,3 y 0,82 según el
          estilo. El radio de
          <a href="https://developer.mozilla.org/es/docs/Web/CSS/backdrop-filter" rel="noopener noreferrer"> <code>blur()</code> </a>
          en CSS es una desviación estándar, así que no equivale 1 a 1 al radio
          de esas funciones.
        </p>
      </section>

      <section class="build" aria-labelledby="hFaq">
        <h2 id="hFaq">Preguntas frecuentes</h2>
        <div class="faq">
          {
            faq.map((f) => (
              <details class="faq-item glasspane">
                <summary>
                  <span class="faq-q">{f.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    >
                      <path d="M12 5v14M5 12h14"></path>
                    </svg>
                  </span>
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>
      </main>
    </div>

    <script>
      import { initLab } from "../lab/main.ts";
      import { frosted } from "../lib/frosted/index.ts";
      initLab(frosted);
    </script>
  </body>
</html>
