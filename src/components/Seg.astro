---
export interface SegItem {
  v: string;
  label: string;
  ariaLabel?: string;
  class?: string;
}

export interface Props {
  seg: string;
  label: string;
  options: SegItem[];
  wide?: boolean;
}

const { seg, label, options, wide = false } = Astro.props;
---

<div
  class:list={["seg", wide && "wide"]}
  data-seg={seg}
  role="radiogroup"
  aria-label={label}
>
  {
    options.map((option) => (
      <button
        type="button"
        role="radio"
        aria-checked="false"
        data-v={option.v}
        aria-label={option.ariaLabel}
        class={option.class}
      >{option.label}</button>
    ))
  }
</div>
