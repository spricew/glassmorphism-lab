---
export interface Props {
  q: string;
  a: string;
}

const { q, a } = Astro.props;
---

<details class="faq-item glasspane">
  <summary>
    <span class="faq-q">{q}</span>
    <span class="faq-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <path d="M12 5v14M5 12h14"></path>
      </svg>
    </span>
  </summary>
  <p>{a}</p>
</details>
