---
export interface Props {
  q: string;
  a: string;
  class?: string;
}

const { q, a, class: cls } = Astro.props;
---
<details class:list={["faq-item", "glasspane", cls]}>
  <summary>
    <span class="faq-q">{q}</span>
    <span class="faq-icon" aria-hidden="true">
      <svg
        viewBox="0 0 16 16"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <line x1="8" y1="3" x2="8" y2="13" />
        <line x1="3" y1="8" x2="13" y2="8" />
      </svg>
    </span>
  </summary>
  <p>{a}</p>
</details>