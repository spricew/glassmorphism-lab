---
export interface Props {
  index: number;
  title: string;
  desc: string;
  panel: string;
  class?: string;
}

const { index, title, desc, panel, class: cls } = Astro.props;
---
<article class:list={["step", cls]}>
  <div class="mini" data-i={index} aria-hidden="true">
    <div class="gl" set:html={panel} />
  </div>
  <div>
    <h3>
      <span>{index}</span>
      {title}
    </h3>
    <p>{desc}</p>
  </div>
</article>